<UserControl x:Class="Nama.App.Views.ArtworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- One artwork tile. The whole tile is the hit target. -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ArtworkTile">
            <Button Style="{StaticResource TileButton}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding Author}">
                <StackPanel>
                    <Grid Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}">

                        <Border x:Name="Frame"
                                CornerRadius="3"
                                Background="{StaticResource SurfaceOverlay}"
                                BorderThickness="2"
                                ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Image Source="{Binding Image}" Stretch="UniformToFill" />

                                <!-- Placeholder while loading or when the preview failed -->
                                <TextBlock Text="&#xE91B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Foreground="{StaticResource MutedText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding FailedToLoad, Converter={StaticResource BoolToVisibility}}" />

                                <!-- Provider badge -->
                                <Border HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="5"
                                        Padding="5,2"
                                        CornerRadius="2"
                                        Background="#B3000000">
                                    <TextBlock Text="{Binding Source}"
                                               FontSize="9"
                                               Foreground="#FFE6E9F0" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Selected check badge -->
                        <Border Width="20" Height="20"
                                CornerRadius="10"
                                Background="{StaticResource Accent}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-6,-6,0"
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="#FF12222F"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding Dimensions}"
                               Style="{StaticResource Caption}"
                               FontSize="10"
                               Opacity="0.6"
                               Margin="2,5,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- One artwork category -->
        <DataTemplate x:Key="SectionTemplate">
            <StackPanel Margin="0,0,0,30">

                <!-- Section header -->
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding Description}"
                                   Style="{StaticResource Caption}"
                                   FontSize="11"
                                   Opacity="0.65"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right"
                            Padding="8,3"
                            FontSize="11"
                            Content="Clear"
                            Command="{Binding ClearSelectionCommand}"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- Tiles. Collapsed: a single row. Expanded: a scrollable picker. -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                    <Setter Property="MaxHeight" Value="{Binding ExpandedHeight}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <ItemsControl ItemsSource="{Binding Displayed}"
                                  ItemTemplate="{StaticResource ArtworkTile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Recommended caption and the expand toggle -->
                <Grid Margin="0,4,0,0">
                    <TextBlock Text="Recommended"
                               Style="{StaticResource Caption}"
                               FontSize="11"
                               Opacity="0.55"
                               VerticalAlignment="Center"
                               Visibility="{Binding ShowRecommendedCaption, Converter={StaticResource BoolToVisibility}}" />

                    <Button Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center"
                            Content="{Binding ToggleLabel}"
                            Command="{Binding ToggleExpandCommand}"
                            Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Name editor -->
        <Grid Grid.Row="0" Margin="40,10,40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Detected: " Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding DetectedName}"
                               Style="{StaticResource Caption}"
                               Foreground="{StaticResource Text}" />
                </StackPanel>

                <TextBlock Text="STEAM NAME" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />

                <TextBox Style="{StaticResource Field}"
                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,2">
                <TextBlock Style="{StaticResource Caption}"
                           HorizontalAlignment="Right"
                           Text="{Binding SteamAccountLabel, StringFormat='Steam account: {0}'}"
                           Visibility="{Binding SteamAccountLabel, Converter={StaticResource StringToVisibility}}" />

                <TextBlock Style="{StaticResource Caption}"
                           HorizontalAlignment="Right"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource Danger}"
                           TextWrapping="Wrap"
                           MaxWidth="280"
                           TextAlignment="Right"
                           Text="{Binding SteamProblem}"
                           Visibility="{Binding HasSteamProblem, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <!-- Artwork sections -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <ProgressBar Style="{StaticResource Spinner}"
                         VerticalAlignment="Top"
                         Margin="40,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="40,10,32,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"
                               Text="{Binding LoadWarning}"
                               Visibility="{Binding LoadWarning, Converter={StaticResource StringToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Sections}"
                                  ItemTemplate="{StaticResource SectionTemplate}" />

                    <StackPanel Visibility="{Binding HasNoArtwork, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,20,0,0">
                        <TextBlock Style="{StaticResource Heading}" Text="No artwork found" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="You can still add the game to Steam and set artwork later." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource Chrome}"
                BorderBrush="#FF000000"
                BorderThickness="0,1,0,0"
                Padding="40,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource GhostButton}"
                        Content="← Back"
                        Margin="-12,0,0,0"
                        Command="{Binding BackCommand}" />

                <TextBlock Grid.Column="1"
                           Style="{StaticResource Caption}"
                           VerticalAlignment="Center"
                           Margin="16,0"
                           Text="{Binding SelectionSummary}" />

                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="160"
                        Content="Add to Steam"
                        Command="{Binding AddToSteamCommand}" />
            </Grid>
        </Border>

        <!-- Duplicate resolution prompt -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="#CC0B0D14"
              Visibility="{Binding IsDuplicatePromptOpen, Converter={StaticResource BoolToVisibility}}">

            <Border Width="440"
                    Background="{StaticResource SurfaceRaised}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="28"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Already in your library"
                               Style="{StaticResource Display}"
                               FontSize="19" />

                    <TextBlock Text="{Binding DuplicateMessage}"
                               Style="{StaticResource Body}"
                               Foreground="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,22" />

                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Update Artwork"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ChooseUpdateArtworkCommand}" />

                    <Button Style="{StaticResource SecondaryButton}"
                            Content="Replace Existing Entry"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0"
                            Command="{Binding ChooseReplaceEntryCommand}" />

                    <Button Style="{StaticResource GhostButton}"
                            Content="Cancel"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"
                            Command="{Binding CancelDuplicateCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
