<UserControl x:Class="Nama.App.Views.IdentifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40,10,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="What game is this?" Style="{StaticResource Display}" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Style="{StaticResource Caption}" Text="{Binding SourceFileName}" />
                <TextBlock Style="{StaticResource Caption}" Text=" · " />
                <TextBlock Style="{StaticResource Caption}"
                           Text="{Binding SourceFolder}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="520" />
            </StackPanel>
        </StackPanel>

        <!-- Search field -->
        <TextBox Grid.Row="1"
                 Style="{StaticResource Field}"
                 Margin="0,20,0,0"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=0}" />

        <!-- What normalization did to the raw name -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="2,10,0,0"
                    Visibility="{Binding ShowNormalization, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Caption}" Text="Detected from " />
            <TextBlock Style="{StaticResource Caption}"
                       Text="{Binding RawName}"
                       FontFamily="Cascadia Mono, Consolas"
                       Foreground="{StaticResource Text}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="560" />
        </StackPanel>

        <!-- Results -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ProgressBar Grid.Row="0"
                         Style="{StaticResource Spinner}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Grid.Row="1"
                       Style="{StaticResource SectionLabel}"
                       Text="POSSIBLE MATCHES"
                       Margin="2,10,0,8" />

            <ListBox Grid.Row="2"
                     x:Name="Results"
                     ItemsSource="{Binding Candidates}"
                     SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="OnResultDoubleClick">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root"
                                            Background="{StaticResource SurfaceRaised}"
                                            BorderBrush="Transparent"
                                            BorderThickness="1.5"
                                            CornerRadius="3"
                                            Padding="12">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceOverlay}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoft}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Cover thumbnail -->
                            <Border Grid.Column="0"
                                    Width="52" Height="72"
                                    CornerRadius="2"
                                    Background="{StaticResource SurfaceOverlay}"
                                    ClipToBounds="True">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           Style="{StaticResource Heading}"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{Binding Subtitle}"
                                           Style="{StaticResource Caption}"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibility}}" />

                                <TextBlock Text="{Binding Details}"
                                           Style="{StaticResource Caption}"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding Details, Converter={StaticResource StringToVisibility}}" />

                                <TextBlock Text="{Binding Sources}"
                                           Style="{StaticResource Caption}"
                                           FontSize="11"
                                           Opacity="0.7"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Match confidence -->
                            <Border Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Padding="8,4"
                                    CornerRadius="2"
                                    Background="{StaticResource SurfaceOverlay}"
                                    Visibility="{Binding ShowConfidence, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Caption}"
                                           FontSize="11"
                                           Text="{Binding Confidence, Converter={StaticResource Confidence}}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Empty state, provider warning and actions -->
        <StackPanel Grid.Row="4" Margin="0,14,0,0">

            <StackPanel Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,12">
                <TextBlock Style="{StaticResource Body}"
                           Text="No matches found. Try a shorter or more common spelling of the title." />
                <Button Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left"
                        Margin="-12,4,0,0"
                        Content="Continue with the name I typed →"
                        Command="{Binding UseTypedNameCommand}" />
            </StackPanel>

            <TextBlock Style="{StaticResource Caption}"
                       Foreground="{StaticResource Danger}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       Text="{Binding ProviderWarning}"
                       Visibility="{Binding ProviderWarning, Converter={StaticResource StringToVisibility}}" />

            <Grid>
                <Button Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left"
                        Content="← Back"
                        Command="{Binding BackCommand}" />

                <Button Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Right"
                        Content="Continue"
                        MinWidth="130"
                        Command="{Binding ConfirmCommand}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
