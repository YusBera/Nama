<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Nama.App.ViewModels">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================ STEP 1 · SELECT ============================ -->
    <DataTemplate DataType="{x:Type vm:SelectViewModel}">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <Border Height="150"
                        CornerRadius="10"
                        BorderThickness="1.5"
                        Background="{StaticResource Surface}"
                        Margin="0,0,0,22">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Drop a game here"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="an executable, or the folder it lives in"
                                   Style="{StaticResource Subtle}"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Select Game"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding BrowseFileCommand}"
                            Margin="0,0,10,0" />
                    <Button Content="Select Folder"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseFolderCommand}" />
                </StackPanel>

                <TextBlock Style="{StaticResource Subtle}"
                           Margin="0,24,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextFaint}"
                           Text="Tip: right-click any game .exe in Explorer to skip this step." />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- =========================== STEP 2 · IDENTIFY =========================== -->
    <DataTemplate DataType="{x:Type vm:IdentifyViewModel}">
        <Grid Margin="28,20,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="What game is this?" Style="{StaticResource Title}" />
                <TextBlock Style="{StaticResource Subtle}"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding SourcePath}" />
            </StackPanel>

            <TextBox Grid.Row="1"
                     Margin="0,16,0,0"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=0}" />

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasResults, Converter={StaticResource BoolToVisible}}">
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row"
                                        Margin="0,0,6,6"
                                        Padding="10"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource Border}"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}" />
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.ChooseCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="46" Height="66"
                                                CornerRadius="4"
                                                Background="{StaticResource SurfaceRaised}"
                                                Margin="0,0,12,0">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding JapaneseName}"
                                                       Style="{StaticResource Subtle}"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasJapaneseName, Converter={StaticResource BoolToVisible}}" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Style="{StaticResource Subtle}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                VerticalAlignment="Top"
                                                Background="{StaticResource SurfaceRaised}"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding SourceLabel}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextFaint}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceRaised}" />
                                    </DataTrigger>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceRaised}" />
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Subtle}"
                           VerticalAlignment="Top"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />

                <TextBlock Text="Searching…"
                           Style="{StaticResource Subtle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Danger}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

                <!-- IsDefault so Enter continues straight from the search box, which is
                     where the caret already is. -->
                <Button Content="Continue"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        IsDefault="True"
                        Command="{Binding ConfirmCommand}"
                        IsEnabled="{Binding CanConfirm}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- =========================== STEP 3 · ARTWORK ============================ -->
    <DataTemplate DataType="{x:Type vm:ArtworkViewModel}">
        <Grid Margin="28,20,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Steam display name, editable before anything is written. -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="STEAM NAME" Style="{StaticResource SectionHeader}" />
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{Binding NoticeMessage}"
                           Style="{StaticResource Subtle}"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Warning}"
                           Visibility="{Binding NoticeMessage, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>

            <!-- One vertical list of categories. Expanding a section never replaces the page. -->
            <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,8,22">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Header}" Style="{StaticResource SectionHeader}" Margin="0" />
                                    <Button Content="Choose local image"
                                            Style="{StaticResource QuietButton}"
                                            Padding="8,3"
                                            FontSize="11"
                                            HorizontalAlignment="Right"
                                            Command="{Binding ImportLocalCommand}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Tiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Tile"
                                                    Margin="0,0,8,8"
                                                    Padding="3"
                                                    CornerRadius="6"
                                                    BorderThickness="2"
                                                    BorderBrush="Transparent"
                                                    Background="{StaticResource Surface}"
                                                    Cursor="Hand">
                                                <!-- AncestorLevel=1 is the inner ItemsControl, whose
                                                     DataContext is the section. Level 2 would be the
                                                     outer one, which is the whole artwork step. -->
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectCommand,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>

                                                <Grid Width="{Binding DataContext.TileWidth,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                      Height="{Binding DataContext.TileHeight,
                                                               RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}">
                                                    <Border Background="{StaticResource SurfaceRaised}" CornerRadius="4" />
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />

                                                    <!-- Selected state has to be unmistakable. -->
                                                    <Border x:Name="Check"
                                                            Visibility="Collapsed"
                                                            Background="{StaticResource Accent}"
                                                            CornerRadius="9"
                                                            Width="18" Height="18"
                                                            Margin="0,4,4,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="✓"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <Border VerticalAlignment="Bottom"
                                                            HorizontalAlignment="Left"
                                                            Background="#B0000000"
                                                            CornerRadius="3"
                                                            Margin="3"
                                                            Padding="4,1">
                                                        <TextBlock Text="{Binding SourceLabel}"
                                                                   FontSize="9"
                                                                   Foreground="#D0D8E0" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource SurfaceRaised}" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid>
                                    <TextBlock Text="Recommended"
                                               Style="{StaticResource Subtle}"
                                               Foreground="{StaticResource TextFaint}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsExpanded, Converter={StaticResource InverseBoolToVisible}}" />

                                    <Button Content="{Binding ExpandLabel}"
                                            Style="{StaticResource ShowMoreButton}"
                                            HorizontalAlignment="Right"
                                            Command="{Binding ToggleExpandCommand}"
                                            Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisible}}" />
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="1"
                       Text="{Binding BusyMessage}"
                       Style="{StaticResource Subtle}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding BusyMessage, Converter={StaticResource NullToCollapsed}}" />

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Danger}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

                <Grid>
                    <TextBlock Style="{StaticResource Subtle}" VerticalAlignment="Center">
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                        <Run Text="artwork selected" />
                    </TextBlock>

                    <Button Content="Add to Steam"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            IsDefault="True"
                            Command="{Binding AddCommand}"
                            IsEnabled="{Binding CanAdd}" />
                </Grid>
            </StackPanel>

            <!-- Duplicate: never silently create a second entry. -->
            <Border Grid.RowSpan="3"
                    Background="#D00E1116"
                    Visibility="{Binding ShowDuplicatePrompt, Converter={StaticResource BoolToVisible}}">
                <Border Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="24"
                        MaxWidth="420"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold">
                            <Run Text="{Binding Duplicate.AppName, Mode=OneWay}" />
                            <Run Text="is already in your Steam library." />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Subtle}"
                                   Margin="0,8,0,18"
                                   TextWrapping="Wrap"
                                   Text="{Binding Duplicate.ExecutablePath, Mode=OneWay}" />

                        <Button Content="Update Artwork"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Command="{Binding UpdateArtworkOnlyCommand}" />
                        <Button Content="Replace Existing Entry"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Command="{Binding ReplaceEntryCommand}" />
                        <Button Content="Cancel"
                                Style="{StaticResource QuietButton}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding CancelDuplicateCommand}" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- Steam open: writing now would be discarded when it exits. -->
            <Border Grid.RowSpan="3"
                    Background="#D00E1116"
                    Visibility="{Binding SteamIsRunning, Converter={StaticResource BoolToVisible}}">
                <Border Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="24"
                        MaxWidth="420"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Steam needs to be closed"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Subtle}"
                                   Margin="0,8,0,18"
                                   TextWrapping="Wrap"
                                   Text="Steam rewrites its shortcuts file when it exits, so a game added now would be lost." />

                        <Button Content="Close Steam &amp; Continue"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,8"
                                Command="{Binding CloseSteamAndRetryCommand}" />
                        <!-- Closing someone's Steam is a big thing to do on their behalf,
                             so there has to be a way out of this prompt. -->
                        <Button Content="Not now"
                                Style="{StaticResource QuietButton}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding DismissSteamPromptCommand}" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- =========================== STEP 4 · SUCCESS ============================ -->
    <DataTemplate DataType="{x:Type vm:SuccessViewModel}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
            <TextBlock Text="✓"
                       FontSize="40"
                       Foreground="{StaticResource Success}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="{Binding Headline}"
                       Style="{StaticResource Title}"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center" />

            <TextBlock Text="{Binding GameName}"
                       FontSize="15"
                       Margin="0,14,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />

            <TextBlock Text="Artwork applied"
                       Style="{StaticResource SectionHeader}"
                       Margin="0,22,0,6"
                       HorizontalAlignment="Center" />

            <ItemsControl ItemsSource="{Binding AppliedArtwork}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Surface}"
                                CornerRadius="4"
                                Padding="8,4"
                                Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" Foreground="{StaticResource Success}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Note}"
                       Style="{StaticResource Subtle}"
                       Margin="0,20,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                <Button Content="Open Steam"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenSteamCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Add Another"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding AddAnotherCommand}"
                        Margin="0,0,8,0" />
                <Button Content="Done"
                        Style="{StaticResource QuietButton}"
                        Command="{Binding DoneCommand}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
