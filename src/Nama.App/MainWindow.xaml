<Window x:Class="Nama.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Nama.App.Views"
        Title="Nama"
        Width="980" Height="720"
        MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <!-- CaptionHeight 0 keeps the whole title bar hit-testable so the custom
             buttons work; dragging is handled by the title bar's mouse handler. -->
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Height="34" Background="{StaticResource ChromeGradient}"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="16" Height="16" CornerRadius="2" Background="{StaticResource Accent}" />
                    <TextBlock Text="Nama"
                               Style="{StaticResource Heading}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource CaptionButton}"
                        Content="&#xE713;"
                        FontSize="13"
                        ToolTip="Settings"
                        Command="{Binding OpenSettingsCommand}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" />
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="OnClose" />
                </StackPanel>
            </Grid>

            <!-- Banner for errors and notices -->
            <Border Grid.Row="1"
                    Margin="16,0,16,0"
                    Padding="14,10"
                    CornerRadius="3"
                    Visibility="{Binding Banner, Converter={StaticResource StringToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceOverlay}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBannerError}" Value="True">
                                <Setter Property="Background" Value="#33EC5C5C" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Banner}"
                               Style="{StaticResource Body}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"
                            Style="{StaticResource GhostButton}"
                            Content="Dismiss"
                            Command="{Binding DismissBannerCommand}" />
                </Grid>
            </Border>

            <!-- Current step -->
            <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Margin="0,8,0,0" />

            <!-- Settings overlay -->
            <Grid Grid.Row="0" Grid.RowSpan="3"
                  Background="#D90E1621"
                  Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
                <views:SettingsView DataContext="{Binding Settings}"
                                    Width="560"
                                    MaxHeight="600"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
