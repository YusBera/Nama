<Window x:Class="Nama.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nama · Settings"
        Height="650" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource Background}"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1"
                Padding="18,0"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Nama · Settings"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Content="×"
                        Width="34" Height="30"
                        FontSize="17"
                        HorizontalAlignment="Right"
                        Style="{StaticResource QuietButton}"
                        ToolTip="Close"
                        Click="OnCloseClick" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,0">

            <!-- SteamGridDB key: the one thing Nama cannot ship for the user. -->
            <TextBlock Text="STEAMGRIDDB API KEY" Style="{StaticResource SectionHeader}" />
            <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas"
                     FontSize="12" />
            <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Optional. Steam and VNDB work without it, but SteamGridDB is where most artwork comes from — grids, heroes, logos and icons. Stored encrypted for your Windows account." />
            <Button Content="Get a key →"
                    Style="{StaticResource QuietButton}"
                    HorizontalAlignment="Left"
                    Margin="-10,4,0,0"
                    Foreground="{StaticResource Accent}"
                    Command="{Binding OpenKeyPageCommand}" />

            <TextBlock Text="EXPERIMENTAL SOURCES" Style="{StaticResource SectionHeader}" Margin="0,20,0,4" />
            <Border Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1"
                    CornerRadius="7">
                <StackPanel>
                    <Grid Margin="14,11">
                        <StackPanel Margin="0,0,64,0">
                            <TextBlock Text="DLsite" FontWeight="SemiBold" />
                            <TextBlock Text="Exact RJ, VJ and BJ code metadata and artwork"
                                       Style="{StaticResource Subtle}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox IsChecked="{Binding ExperimentalDlsiteEnabled}"
                                  Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource Border}" />
                    <Grid Margin="14,11">
                        <StackPanel Margin="0,0,64,0">
                            <TextBlock Text="VNDB" FontWeight="SemiBold" />
                            <TextBlock Text="Visual novel matching, package covers and screenshots"
                                       Style="{StaticResource Subtle}" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox IsChecked="{Binding ExperimentalVndbEnabled}"
                                  Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Account picker, shown only when the choice actually exists. -->
            <StackPanel Margin="0,22,0,0"
                        Visibility="{Binding HasMultipleAccounts, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="STEAM ACCOUNT" Style="{StaticResource SectionHeader}" />
                <ComboBox ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount}"
                          Padding="8,6">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Text="{Binding AccountId, StringFormat=' ({0})'}"
                                           Foreground="{StaticResource TextFaint}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Shortcuts and artwork are per-account. Defaults to the one you used most recently." />
            </StackPanel>

            <!-- Explorer integration -->
            <TextBlock Text="EXPLORER RIGHT-CLICK MENU" Style="{StaticResource SectionHeader}" Margin="0,22,0,8" />
            <Grid>
                <TextBlock VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Not installed" />
                            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ContextMenuInstalled}" Value="True">
                                    <Setter Property="Text" Value="Installed" />
                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button HorizontalAlignment="Right"
                        Command="{Binding ToggleContextMenuCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="Content" Value="Add to right-click menu" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ContextMenuInstalled}" Value="True">
                                    <Setter Property="Content" Value="Remove" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <TextBlock Text="{Binding ContextMenuNote}"
                       Style="{StaticResource Subtle}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap" />

            <!-- Cache -->
            <TextBlock Text="CACHE" Style="{StaticResource SectionHeader}" Margin="0,22,0,8" />
            <Grid>
                <TextBlock Style="{StaticResource Subtle}" VerticalAlignment="Center">
                    <Run Text="{Binding CacheCount, Mode=OneWay}" />
                    <Run Text="cached responses" />
                </TextBlock>
                <Button Content="Clear cache"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Right"
                        Command="{Binding ClearCacheCommand}" />
            </Grid>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="24,18,24,24">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource Danger}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Subtle}"
                           Foreground="{StaticResource Success}"
                           VerticalAlignment="Center"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save"
                            Style="{StaticResource PrimaryButton}"
                            IsDefault="True"
                            Command="{Binding SaveCommand}"
                            Margin="0,0,8,0" />
                    <Button x:Name="CloseButton"
                            Content="Close"
                            Style="{StaticResource SecondaryButton}"
                            IsCancel="True" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
